9:["$","div",null,{"className":"mt-8 space-y-5 leading-relaxed text-neutral-600","children":[["$","p",null,{"children":"ForestView Homestay là một căn nhà gỗ nhỏ nằm giữa rừng thông ở Đà Lạt, được chúng tôi xây dựng và vun đắp từ tình yêu với những buổi sáng sương mù và nhịp sống chậm rãi."}],["$","p",null,{"children":"Chúng tôi tự tay chăm chút từng phòng nghỉ — từ phòng đơn ấm cúng cho khách đi một mình, đến phòng gia đình rộng rãi có sân vườn riêng — để mỗi vị khách đều tìm được không gian phù hợp nhất với chuyến đi của mình."}],["$","p",null,{"children":"Đây không phải là một nền tảng trung gian — ForestView là homestay của chính chúng tôi, và chúng tôi trực tiếp đón tiếp, chăm sóc từng vị khách trong suốt thời gian lưu trú."}]]}]
