      "routeKeys": {},
      "namedRegex": "^/admin/bookings(?:/)?$"
    },
    {
      "page": "/admin/discount-codes",
      "regex": "^/admin/discount\\-codes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/discount\\-codes(?:/)?$"
    },
    {
      "page": "/admin/holidays",
      "regex": "^/admin/holidays(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/holidays(?:/)?$"
    },
    {
      "page": "/admin/rooms",
      "regex": "^/admin/rooms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/rooms(?:/)?$"
    },
    {
      "page": "/admin/users",
      "regex": "^/admin/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/users(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/forgot-password",
      "regex": "^/forgot\\-password(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/forgot\\-password(?:/)?$"
